generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  CANDIDATE
  EMPLOYER_ADMIN
  EMPLOYER_RECRUITER
  PLATFORM_ADMIN
  PLATFORM_OPERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AuthPurpose {
  LOGIN
  REGISTER
}

enum OtpChannel {
  MOBILE
  EMAIL
}

model User {
  id             String     @id @default(uuid())
  externalAuthId String     @unique @map("external_auth_id")
  email          String?    @unique
  phone          String     @unique
  passwordHash   String?    @map("password_hash")
  userType       UserType   @map("user_type")
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?  @map("last_login_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  candidate     Candidate?
  employer      Employer?
  refreshTokens RefreshToken[]

  @@map("users")
}

model Candidate {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  firstName             String?  @map("first_name")
  lastName              String?  @map("last_name")
  city                  String?
  preferredLanguage     String?  @map("preferred_language")
  dateOfBirth           DateTime? @map("date_of_birth")
  gender                String?
  openToRelocating      Boolean  @default(false) @map("open_to_relocating")
  highestEducation      String?  @map("highest_education")
  stillInCollege        Boolean  @default(false) @map("still_in_college")
  educationStart        String?  @map("education_start")
  educationEnd          String?  @map("education_end")
  experienceLevel       String?  @map("experience_level")
  totalExperienceYears  Int      @default(0) @map("total_experience_years")
  totalExperienceMonths Int      @default(0) @map("total_experience_months")
  gapReason             String?  @map("gap_reason") @db.Text
  about                 String?  @db.Text
  source                String?  @default("manual")
  careerInterests       String   @default("[]") @map("career_interests")
  certifications        String   @default("[]")
  projects              String   @default("[]")
  photoUrl              String?  @map("photo_url") @db.Text
  profileLinks          String   @default("{}") @map("profile_links")
  hasExperience         String?  @map("has_experience")
  onboardingCompleted   Boolean  @default(false) @map("onboarding_completed")
  profileCompletion     Int      @default(0) @map("profile_completion")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  education     CandidateEducation[]
  skills        CandidateSkill[]
  experiences   CandidateExperience[]
  resumes       Resume[]
  applications  Application[]
  interviews    Interview[]

  @@map("candidates")
}

model CandidateEducation {
  id             String   @id @default(uuid())
  candidateId    String   @map("candidate_id")
  qualification  String
  institution    String?
  fieldOfStudy   String?  @map("field_of_study")
  yearCompleted  Int?     @map("year_completed")
  startDate      String?  @map("start_date")
  endDate        String?  @map("end_date")
  createdAt      DateTime @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_education")
}

model CandidateSkill {
  id          String   @id @default(uuid())
  candidateId String   @map("candidate_id")
  name        String
  createdAt   DateTime @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, name])
  @@index([candidateId])
  @@map("candidate_skills")
}

model CandidateExperience {
  id           String    @id @default(uuid())
  candidateId  String    @map("candidate_id")
  company      String
  jobTitle     String    @map("job_title")
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  description  String?
  isInternship Boolean   @default(false) @map("is_internship")
  stillInCompany Boolean  @default(false) @map("still_in_company")
  createdAt    DateTime  @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_experiences")
}

model OtpRequest {
  id           String      @id @default(uuid())
  phone        String      @default("")
  email        String?
  channel      OtpChannel  @default(MOBILE)
  purpose      AuthPurpose
  otpHash      String?     @map("otp_hash")
  payloadJson  String?     @map("payload_json")
  expiresAt    DateTime    @map("expires_at")
  verifiedAt   DateTime?   @map("verified_at")
  attemptCount Int         @default(0) @map("attempt_count")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([phone])
  @@index([email])
  @@map("otp_requests")
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
  HIRED
}

model Employer {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  companyName String   @map("company_name")
  industry    String?
  city        String?
  contactName String?  @map("contact_name")
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@map("employers")
}

model Job {
  id              String    @id @default(uuid())
  employerId      String    @map("employer_id")
  title           String
  description     String
  city            String
  salaryMin       Int?      @map("salary_min")
  salaryMax       Int?      @map("salary_max")
  jobType         String    @default("FULL_TIME") @map("job_type")
  category        String
  experience      String?
  requiredSkills  String    @default("[]") @map("required_skills")
  preferredSkills String    @default("[]") @map("preferred_skills")
  benefits        String?
  status          JobStatus @default(DRAFT)
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  employer     Employer      @relation(fields: [employerId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([status, city])
  @@index([category])
  @@map("jobs")
}

enum ResumeKind {
  ORIGINAL
  OPTIMIZED
}

enum OptimizationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Resume {
  id             String     @id @default(uuid())
  candidateId    String     @map("candidate_id")
  title          String
  targetJobTitle String?    @map("target_job_title")
  template       String     @default("CLASSIC")
  summary        String?
  contentJson    String     @default("{}") @map("content_json")
  rawText        String?    @map("raw_text") @db.Text
  score          Int        @default(0)
  version        Int        @default(1)
  kind           ResumeKind @default(ORIGINAL)
  parentResumeId String?    @map("parent_resume_id")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  candidate      Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  parent         Resume?               @relation("ResumeLineage", fields: [parentResumeId], references: [id], onDelete: SetNull)
  versions       Resume[]              @relation("ResumeLineage")
  applications   Application[]
  analysis       ResumeAtsReport?
  facts          ResumeFact[]
  issues         ResumeIssue[]
  sourceOpts     ResumeOptimization[]  @relation("OptSource")
  resultOpts     ResumeOptimization[]  @relation("OptResult")

  @@index([candidateId])
  @@index([parentResumeId])
  @@map("resumes")
}

model ResumeAtsReport {
  id             String   @id @default(uuid())
  resumeId       String   @unique @map("resume_id")
  scoreType      String   @default("ATS_READINESS") @map("score_type")
  overallScore   Int      @map("overall_score")
  label          String
  sectionJson    String   @map("section_json") @db.Text
  issuesJson     String   @map("issues_json") @db.Text
  highPriority   Int      @default(0) @map("high_priority")
  mediumPriority Int      @default(0) @map("medium_priority")
  goodSections   Int      @default(0) @map("good_sections")
  recommendedPlanId String @map("recommended_plan_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("resume_ats_reports")
}

model ResumeIssue {
  id             String @id @default(uuid())
  resumeId       String @map("resume_id")
  section        String
  severity       String
  problem        String
  location       String
  why            String @db.Text
  recommendation String @db.Text
  originalExample String? @map("original_example") @db.Text
  suggestedExample String? @map("suggested_example") @db.Text

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("resume_issues")
}

model ResumeFact {
  id      String @id @default(uuid())
  resumeId String @map("resume_id")
  factType String @map("fact_type")
  value   String
  source  String @db.Text
  section String

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("resume_facts")
}

model ResumeOptimization {
  id                String              @id @default(uuid())
  sourceResumeId    String              @map("source_resume_id")
  resultResumeId    String?             @unique @map("result_resume_id")
  planId            String              @map("plan_id")
  targetMin         Int                 @map("target_min")
  targetMax         Int                 @map("target_max")
  status            OptimizationStatus  @default(PENDING)
  beforeScore       Int                 @map("before_score")
  afterScore        Int?                @map("after_score")
  factPreservation  Int?                @map("fact_preservation")
  improvementsJson  String              @default("[]") @map("improvements_json")
  changesJson       String              @default("[]") @map("changes_json") @db.Text
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  source Resume  @relation("OptSource", fields: [sourceResumeId], references: [id], onDelete: Cascade)
  result Resume? @relation("OptResult", fields: [resultResumeId], references: [id], onDelete: SetNull)

  @@index([sourceResumeId])
  @@map("resume_optimizations")
}

model Application {
  id            String            @id @default(uuid())
  candidateId   String            @map("candidate_id")
  jobId         String            @map("job_id")
  resumeId      String?           @map("resume_id")
  resumeVersion Int?              @map("resume_version")
  status        ApplicationStatus @default(APPLIED)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume    Resume?   @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@unique([candidateId, jobId])
  @@index([jobId])
  @@map("applications")
}

model Interview {
  id                 String    @id @default(uuid())
  candidateId        String    @map("candidate_id")
  jobRole            String    @map("job_role")
  interviewType      String    @map("interview_type")
  status             String    @default("IN_PROGRESS")
  questionIndex      Int       @default(0) @map("question_index")
  questionsJson      String    @map("questions_json")
  answersJson        String    @default("[]") @map("answers_json")
  score              Int?
  feedbackJson       String?   @map("feedback_json")
  mode               String    @default("CLASSIC")
  source             String?
  startAt            DateTime? @map("start_at")
  endAt              DateTime? @map("end_at")
  durationSec        Int?      @map("duration_sec")
  durationLimitMin   Int?      @map("duration_limit_min")
  difficulty         String?
  profileJson        String?   @map("profile_json") @db.Text
  transcriptJson     String    @default("[]") @map("transcript_json") @db.Text
  warningsJson       String    @default("[]") @map("warnings_json") @db.Text
  reportJson         String?   @map("report_json") @db.Text
  communicationScore Int?      @map("communication_score")
  behaviourScore     Int?      @map("behaviour_score")
  listeningScore     Int?      @map("listening_score")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("interviews")
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([category])
  @@map("skills")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  jti       String?   @unique
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}
