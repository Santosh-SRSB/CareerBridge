# CareerBridge Web (Next.js) — Cloud Run DEV
# Build from repo root (example):
#   docker build -f infrastructure/docker/Dockerfile.web \
#     --build-arg NEXT_PUBLIC_API_URL=https://…/api/v1 \
#     -t careerbridge-web:local .

FROM node:22-bookworm-slim AS builder
WORKDIR /app

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_AUTH_DEV_OTP=false
ARG NEXT_PUBLIC_FIREBASE_API_KEY
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ARG NEXT_PUBLIC_FIREBASE_APP_ID
ARG NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID
ARG NEXT_PUBLIC_FIREBASE_VAPID_KEY=
ARG CAREERBRIDGE_RELEASE=dev

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_AUTH_DEV_OTP=$NEXT_PUBLIC_AUTH_DEV_OTP
ENV NEXT_PUBLIC_FIREBASE_API_KEY=$NEXT_PUBLIC_FIREBASE_API_KEY
ENV NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=$NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ENV NEXT_PUBLIC_FIREBASE_PROJECT_ID=$NEXT_PUBLIC_FIREBASE_PROJECT_ID
ENV NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=$NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
ENV NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=$NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ENV NEXT_PUBLIC_FIREBASE_APP_ID=$NEXT_PUBLIC_FIREBASE_APP_ID
ENV NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=$NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID
ENV NEXT_PUBLIC_FIREBASE_VAPID_KEY=$NEXT_PUBLIC_FIREBASE_VAPID_KEY
ENV NEXT_PUBLIC_CAREERBRIDGE_RELEASE=$CAREERBRIDGE_RELEASE
ENV NEXT_TELEMETRY_DISABLED=1

# DEV builds leave CAREERBRIDGE_RELEASE unset or "dev" and may use the DEV Cloud Build file.
# A production image must pass CAREERBRIDGE_RELEASE=production plus its own API URL and Firebase project.
RUN set -eu; \
  if [ "$CAREERBRIDGE_RELEASE" = "production" ]; then \
    case "$NEXT_PUBLIC_API_URL" in \
      https://*) ;; \
      *) echo "production web build requires https NEXT_PUBLIC_API_URL"; exit 1 ;; \
    esac; \
    printf '%s' "$NEXT_PUBLIC_API_URL" | grep -Eqi 'careerbridge-api-dev|careerbridge-f7b72|localhost|127\.0\.0\.1|srsbbucket' \
      && { echo "production web build refuses a DEV or local API URL"; exit 1; }; \
    if [ -z "$NEXT_PUBLIC_FIREBASE_PROJECT_ID" ] || printf '%s' "$NEXT_PUBLIC_FIREBASE_PROJECT_ID" | grep -Eqi 'careerbridge-f7b72'; then \
      echo "production web build requires a non-DEV NEXT_PUBLIC_FIREBASE_PROJECT_ID"; exit 1; \
    fi; \
    if printf '%s' "$NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN" | grep -Eqi 'careerbridge-f7b72'; then \
      echo "production web build refuses the DEV Firebase auth domain"; exit 1; \
    fi; \
    if printf '%s' "$NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET" | grep -Eqi 'careerbridge-f7b72|srsbbucket'; then \
      echo "production web build refuses a DEV storage bucket"; exit 1; \
    fi; \
    if [ "$NEXT_PUBLIC_AUTH_DEV_OTP" = "true" ]; then \
      echo "production web build refuses NEXT_PUBLIC_AUTH_DEV_OTP=true"; exit 1; \
    fi; \
  fi
# Do NOT set NODE_ENV=development here. Next.js 16 prerender of /_global-error
# crashes with "Cannot read properties of null (reading 'useContext')" when
# NODE_ENV=development is forced during `next build`.

COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

# --include=dev: Cloud Build/Docker often inherit NODE_ENV=production, which would
# skip Tailwind/PostCSS without this flag. Install Linux optional natives after ci
# because Windows lockfiles omit them.
RUN npm ci --include=dev --ignore-scripts \
  && npm install --no-save --include=optional lightningcss-linux-x64-gnu @tailwindcss/oxide-linux-x64-gnu \
  && test -e apps/web/node_modules/@tailwindcss/postcss/package.json \
  && NODE_ENV=production npm run build -w @careerbridge/shared \
  && NODE_ENV=production npm run build -w web

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1

RUN apt-get update -y && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

USER nextjs
EXPOSE 8080
CMD ["node", "apps/web/server.js"]
