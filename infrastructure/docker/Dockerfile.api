# CareerBridge API — production image for Cloud Run (asia-south1)
# Build from repo root:
#   docker build -f infrastructure/docker/Dockerfile.api -t careerbridge-api:dev .
# Or:
#   gcloud builds submit --config=infrastructure/cloudbuild.api.yaml --substitutions=_TAG=<sha> .

FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
# Root package.json has postinstall "build shared" — skip until sources exist.
RUN npm ci --ignore-scripts

FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json /app/package-lock.json ./
COPY --from=deps /app/apps/api/package.json ./apps/api/
COPY --from=deps /app/apps/web/package.json ./apps/web/
COPY --from=deps /app/packages/shared/package.json ./packages/shared/
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api
COPY infrastructure/docker/pack-prisma-cli.mjs /tmp/pack-prisma-cli.mjs
RUN npm run build -w @careerbridge/shared \
  && npm run prisma:generate -w api \
  && npm run build -w api \
  && node /tmp/pack-prisma-cli.mjs --download --list /tmp/prisma-cli-files.txt \
  && tar -czf /tmp/prisma-cli.tgz -C /app --exclude=node_modules/@prisma/engines/node_modules/.cache -T /tmp/prisma-cli-files.txt \
  && test -s /tmp/prisma-cli.tgz

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
ENV HOME=/home/api
# Stay on Debian 12. Install only the bookworm-security perl-base pin.
# apt-get fails if 5.36.0-7+deb12u4 is not in the image's bookworm-security index.
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl ca-certificates \
  && apt-get install -y --no-install-recommends perl-base=5.36.0-7+deb12u4 \
  && test "$(dpkg-query -W -f='$${Version}' perl-base)" = "5.36.0-7+deb12u4" \
  && rm -rf /var/lib/apt/lists/* \
  && addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 --ingroup nodejs --home /home/api api

COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
# Production npm ci omits the devDependency prisma. The builder packs the
# lockfile closure for Prisma CLI 6.19.3, including transitive dependencies and
# the engine binaries downloaded by @prisma/fetch-engine.
RUN npm ci --omit=dev --ignore-scripts -w api -w @careerbridge/shared \
  && npm cache clean --force
COPY --from=builder /tmp/prisma-cli.tgz /tmp/prisma-cli.tgz
RUN tar -xzf /tmp/prisma-cli.tgz -C /app \
  && rm -f /tmp/prisma-cli.tgz \
  && mkdir -p /app/node_modules/.bin \
  && ln -sf ../prisma/build/index.js /app/node_modules/.bin/prisma \
  && chmod 755 /app/node_modules/prisma/build/index.js /app/node_modules/.bin/prisma \
  && chmod 755 /app/node_modules/@prisma/engines/schema-engine-debian-openssl-3.0.x \
  && test -s /app/node_modules/@prisma/engines/schema-engine-debian-openssl-3.0.x \
  && node -e "const version=require('/app/node_modules/prisma/package.json').version; if (version!=='6.19.3') process.exit(1)"

COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/generated ./apps/api/generated
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY apps/api/docker-entrypoint.sh ./apps/api/docker-entrypoint.sh
# The process can read the image and write only its home directory.
# Application code and node_modules stay owned by root.
# npm ci has already finished. Remove only the base image npm CLI.
# Keep node, the production node_modules tree, and the packed Prisma CLI.
RUN sed -i 's/\r$//' ./apps/api/docker-entrypoint.sh && chmod +x ./apps/api/docker-entrypoint.sh \
  && chown -R api:nodejs /home/api \
  && rm -rf /usr/local/lib/node_modules/npm \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx \
  && if command -v npm >/dev/null 2>&1 || command -v npx >/dev/null 2>&1; then echo "npm CLI remains in the runtime image"; exit 1; fi \
  && test -x /usr/local/bin/node \
  && test -x /app/node_modules/.bin/prisma \
  && test -s /app/node_modules/@prisma/engines/schema-engine-debian-openssl-3.0.x

WORKDIR /app/apps/api
USER api
EXPOSE 8080
CMD ["./docker-entrypoint.sh"]
