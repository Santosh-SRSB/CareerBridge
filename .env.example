# Copy into apps/api/.env and apps/web/.env.local

# API (apps/api/.env)
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://careerbridge:careerbridge@127.0.0.1:5432/careerbridge?schema=public
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
WEB_ORIGIN=http://localhost:3000
AUTH_DEV_OTP=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Centralized AI Gateway (Gemini primary per Volume 2 HLD, OpenAI fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- IRIS IRP GSTIN verification (server-only; never put secrets in apps/web) ---
# Official docs: https://einvoice6.gst.gov.in/content/core-apis-wiki/
GST_ENV=sandbox
GST_SANDBOX_BASE_URL=https://sandbox-placeholder.example.com
GST_PRODUCTION_BASE_URL=https://production-placeholder.example.com
GST_SANDBOX_PORTAL_ID=DEMO_SANDBOX_PORTAL_ID
GST_SANDBOX_CLIENT_ID=DEMO_SANDBOX_CLIENT_ID
GST_SANDBOX_CLIENT_SECRET=DEMO_SANDBOX_CLIENT_SECRET
GST_SANDBOX_USERNAME=DEMO_SANDBOX_USERNAME
GST_SANDBOX_PASSWORD=DEMO_SANDBOX_PASSWORD
GST_SANDBOX_REQUESTER_GSTIN=29AAAAA0000A1Z5
GST_PRODUCTION_PORTAL_ID=DEMO_PRODUCTION_PORTAL_ID
GST_PRODUCTION_CLIENT_ID=DEMO_PRODUCTION_CLIENT_ID
GST_PRODUCTION_CLIENT_SECRET=DEMO_PRODUCTION_CLIENT_SECRET
GST_PRODUCTION_USERNAME=DEMO_PRODUCTION_USERNAME
GST_PRODUCTION_PASSWORD=DEMO_PRODUCTION_PASSWORD
GST_PRODUCTION_REQUESTER_GSTIN=29AAAAA0000A1Z5
# Confirm paths in IRIS Core APIs wiki once you have portal access
GST_AUTH_PATH=/eivital/v1.04/auth
GST_GET_GSTIN_PATH=/eivital/v1.04/Master/gstin/{gstin}
GST_PUBLIC_KEY_PEM=
GST_API_TIMEOUT_MS=15000
GST_API_MAX_RETRIES=2
# Local UI only until real sandbox credentials arrive (disabled automatically when configured=true)
GST_MOCK_ENABLED=true
GST_MOCK_ACTIVE_GSTIN=29AAAAA0000A1Z5
GST_MOCK_INACTIVE_GSTIN=29BBBBB0000B1Z5

# Impact.com Mediapartners (Udemy affiliate) — put real values only in apps/api/.env
# Never commit tokens. Reset the token if it was pasted in chat.
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
IMPACT_API_BASE=https://api.impact.com
IMPACT_CATALOG_ID=26324

# WEB (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_AUTH_DEV_OTP=true
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Existing web keys
Open_Ai_Api_key=
