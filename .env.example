# Copy into apps/api/.env and apps/web/.env.local

# API (apps/api/.env)
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://careerbridge:careerbridge@127.0.0.1:5432/careerbridge?schema=public
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
WEB_ORIGIN=http://localhost:3000
AUTH_DEV_OTP=true
# SRSB admin portal (/srsbaadmin) — seeded into `admins` with hashed password
# SRSB_ADMIN_EMAIL=srsbhr25@gmail.com
# SRSB_ADMIN_PASSWORD=change-me
# SRSB_ADMIN_PHONE=+919999999025
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional: path to service-account JSON instead of the three vars above
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# Never commit the JSON or private key.
# Centralized AI Gateway — Gemini only (Volume 2 ADR-005). No OpenAI fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
# Optional: enrich top 5 matches with Gemini after rules+vector (extra cost)
AI_MATCH_ENRICH=false

EMPLOYER_SKIP_POSTING_PAYMENT=
GSTINAPI_KEY=
GST_ENV=sandbox
GST_SANDBOX_BASE_URL=https://sandbox-placeholder.example.com
GST_PRODUCTION_BASE_URL=https://production-placeholder.example.com
GST_SANDBOX_PORTAL_ID=DEMO_SANDBOX_PORTAL_ID
GST_SANDBOX_CLIENT_ID=DEMO_SANDBOX_CLIENT_ID
GST_SANDBOX_CLIENT_SECRET=DEMO_SANDBOX_CLIENT_SECRET
GST_SANDBOX_USERNAME=DEMO_SANDBOX_USERNAME
GST_SANDBOX_PASSWORD=DEMO_SANDBOX_PASSWORD
GST_SANDBOX_REQUESTER_GSTIN=29AAAAA0000A1Z5
GST_PRODUCTION_PORTAL_ID=DEMO_PRODUCTION_PORTAL_ID
GST_PRODUCTION_CLIENT_ID=DEMO_PRODUCTION_CLIENT_ID
GST_PRODUCTION_CLIENT_SECRET=DEMO_PRODUCTION_CLIENT_SECRET
GST_PRODUCTION_USERNAME=DEMO_PRODUCTION_USERNAME
GST_PRODUCTION_PASSWORD=DEMO_PRODUCTION_PASSWORD
GST_PRODUCTION_REQUESTER_GSTIN=29AAAAA0000A1Z5
# Confirm paths in IRIS Core APIs wiki once you have portal access
GST_AUTH_PATH=/eivital/v1.04/auth
GST_GET_GSTIN_PATH=/eivital/v1.04/Master/gstin/{gstin}
GST_PUBLIC_KEY_PEM=
GST_API_TIMEOUT_MS=15000
GST_API_MAX_RETRIES=2
# Local UI only until real sandbox credentials arrive (disabled automatically when configured=true)
GST_MOCK_ENABLED=true
GST_MOCK_ACTIVE_GSTIN=29AAAAA0000A1ZY
GST_MOCK_INACTIVE_GSTIN=29BBBBB0000B1ZP

# Impact.com Mediapartners (Udemy affiliate) — put real values only in apps/api/.env
# Never commit tokens. Reset the token if it was pasted in chat.
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
IMPACT_API_BASE=https://api.impact.com
IMPACT_CATALOG_ID=26324

# WhatsApp Cloud API (Meta) — never commit real tokens
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DISPLAY_PHONE=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_USE_TEMPLATES=false
WHATSAPP_REQUIRE_SIGNATURE=false
WHATSAPP_REQUIRE_OPT_IN=false
WHATSAPP_TASK_SECRET=
# Optional Cloud Tasks worker URL for WhatsApp jobs
WHATSAPP_WORKER_URL=
CLOUD_TASKS_WHATSAPP_QUEUE=
API_PUBLIC_URL=http://localhost:3001
# Template name overrides (Meta-approved names)
# WHATSAPP_TEMPLATE_INTERVIEW_INVITATION=interview_invitation
# WHATSAPP_TEMPLATE_INTERVIEW_REMINDER_15M=interview_reminder_15m

# WEB (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_AUTH_DEV_OTP=true
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web Push certificate key from Firebase Console → Project settings → Cloud Messaging
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Existing web keys
Open_Ai_Api_key=
