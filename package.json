{
  "name": "careerbridge",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run start:dev -w api",
    "dev:web": "npm run dev:webpack -w web",
    "build": "npm run build -w @careerbridge/shared && npm run build -w api && npm run build -w web",
    "db:up": "docker compose up -d",
    "db:migrate": "npm run prisma:migrate -w api",
    "db:generate": "npm run prisma:generate -w api",
    "postinstall": "npm run build -w @careerbridge/shared"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
