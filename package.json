{
  "name": "careerbridge",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run start:dev -w api",
    "dev:web": "npm run dev:webpack -w web",
    "build": "npm run build -w @careerbridge/shared && npm run build -w api && npm run build -w web",
    "db:up": "docker compose up -d",
    "db:migrate": "npm run prisma:migrate -w api",
    "db:generate": "npm run prisma:generate -w api",
    "postinstall": "npm run build -w @careerbridge/shared"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "multer": "2.4.0",
    "lodash": "4.18.1",
    "js-yaml": "4.3.2",
    "source-map-js": "1.2.2",
    "glob@10.4.5": "10.5.0",
    "brace-expansion@1.1.18": "1.1.21",
    "brace-expansion@2.1.4": "2.1.7"
  },
  "devDependencies": {
    "concurrently": "9.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
